+    override fun query(uri: Uri, p: Array<out String>?, s: String?, a: Array<out String>?, o: String?): Cursor? = null
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = throw UnsupportedOperationException()
+    override fun delete(uri: Uri, s: String?, a: Array<out String>?) = throw UnsupportedOperationException()
+    override fun update(uri: Uri, values: ContentValues?, s: String?, a: Array<out String>?) = throw UnsupportedOperationException()
+
+    @Synchronized override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor {
+        val key = uri.lastPathSegment ?: throw FileNotFoundException()
+        if (mode != "r" || uri.pathSegments.firstOrNull() != "art" || !key.matches(Regex("[a-f0-9]{64}"))) throw FileNotFoundException()
+        val dir = File(requireNotNull(context).filesDir, "preview-art")
+        val metadata = File(dir, "$key.json")
+        if (!metadata.exists()) throw FileNotFoundException()
+        val output = File(dir, "$key.jpg")
+        if (!output.exists() || output.lastModified() < metadata.lastModified()) {
+            val data = JSONObject(metadata.readText())
+            val bitmap = Bitmap.createBitmap(3840, 2160, Bitmap.Config.ARGB_8888)
+            try {
+                val canvas = Canvas(bitmap)
+                val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+                paint.shader = LinearGradient(0f, 0f, 3840f, 2160f, intArrayOf(Color.rgb(28, 66, 131), Color.rgb(10, 18, 34)), null, Shader.TileMode.CLAMP)
+                canvas.drawRect(0f, 0f, 3840f, 2160f, paint)
+                paint.shader = null; paint.color = Color.WHITE; paint.typeface = Typeface.create("sans-serif", Typeface.BOLD)
+                paint.textSize = 95f; canvas.drawText("ASTRA", 200f, 240f, paint)
+                paint.textSize = 68f; canvas.drawText(data.optString("competition"), 200f, 420f, paint)
+                val title = data.optString("title")
+                val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE; textSize = 178f; typeface = Typeface.create("sans-serif", Typeface.BOLD) }
+                val layout = StaticLayout.Builder.obtain(title, 0, title.length, textPaint, 3200).setAlignment(Layout.Alignment.ALIGN_NORMAL).setMaxLines(4).build()
+                canvas.save(); canvas.translate(200f, 750f); layout.draw(canvas); canvas.restore()
+                paint.textSize = 68f; canvas.drawText(if (data.optString("status") == "live") "LIVE NOW" else "MY TEAMS · SPORTS", 200f, 1910f, paint)
+                val temporary = File(dir, "$key.tmp")
+                temporary.outputStream().use { bitmap.compress(Bitmap.CompressFormat.JPEG, 94, it) }
+                if (!temporary.renameTo(output)) throw FileNotFoundException()
+            } finally { bitmap.recycle() }
+        }
+        return ParcelFileDescriptor.open(output, ParcelFileDescriptor.MODE_READ_ONLY)
+    }
+}
