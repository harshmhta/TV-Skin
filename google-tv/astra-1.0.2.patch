+package dev.astra.tv.ui.player
+
+import androidx.media3.common.Player
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ScreenAwakeTest {
+    @Test fun playingAndBufferingKeepDisplayAwake() {
+        assertTrue(shouldKeepScreenAwake(true, Player.STATE_READY))
+        assertTrue(shouldKeepScreenAwake(true, Player.STATE_BUFFERING))
+    }
+    @Test fun pausedStoppedEndedAndFailedPlaybackAllowScreensaver() {
+        assertFalse(shouldKeepScreenAwake(false, Player.STATE_READY))
+        assertFalse(shouldKeepScreenAwake(false, Player.STATE_BUFFERING))
+        assertFalse(shouldKeepScreenAwake(true, Player.STATE_IDLE))
+        assertFalse(shouldKeepScreenAwake(true, Player.STATE_ENDED))
+    }
+}
