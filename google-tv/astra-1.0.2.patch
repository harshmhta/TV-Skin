diff --git a/app/src/main/java/dev/astra/tv/discovery/AstraPreviews.kt b/app/src/main/java/dev/astra/tv/discovery/AstraPreviews.kt
new file mode 100644
index 0000000..a721563
--- /dev/null
+++ b/app/src/main/java/dev/astra/tv/discovery/AstraPreviews.kt
@@ -0,0 +1,80 @@
+package dev.astra.tv.discovery
+
+import android.content.ContentValues
+import android.content.Context
+import android.content.Intent
+import android.media.tv.TvContract
+import android.util.Log
+import dev.astra.tv.MainActivity
+import dev.astra.tv.data.Event
+import dev.astra.tv.data.HomeResponse
+import org.json.JSONObject
+import java.io.File
+import java.security.MessageDigest
+import java.util.concurrent.Executors
+
+object AstraPreviews {
+    private val worker = Executors.newSingleThreadExecutor()
+
+    fun publish(context: Context, home: HomeResponse) {
+        val app = context.applicationContext
+        worker.execute {
+            runCatching {
+                val cr = app.contentResolver
+                val prefs = app.getSharedPreferences("previews", 0)
+                var channelId = prefs.getLong("channel", -1)
+                val exists = channelId >= 0 && cr.query(TvContract.buildChannelUri(channelId), arrayOf("_id"), null, null, null)?.use { it.moveToFirst() } == true
+                if (!exists) {
+                    val values = ContentValues().apply {
+                        put("type", TvContract.Channels.TYPE_PREVIEW)
+                        put("display_name", "Astra · My teams and live sports")
+                        put("app_link_intent_uri", Intent(app, MainActivity::class.java).toUri(Intent.URI_INTENT_SCHEME))
+                        put("searchable", 1)
+                    }
+                    channelId = cr.insert(TvContract.Channels.CONTENT_URI, values)!!.lastPathSegment!!.toLong()
+                    prefs.edit().putLong("channel", channelId).apply()
+                }
+                cr.delete(TvContract.buildPreviewProgramsUriForChannel(channelId), null, null)
+                val events = (home.myTeams.live + home.myTeams.upcoming + home.myTeams.recent + home.sports.flatMap { it.live })
+                    .filter { it.feeds.isNotEmpty() }.distinctBy { it.id }.take(20)
+                events.forEachIndexed { i, event ->
+                    cr.insert(TvContract.PreviewPrograms.CONTENT_URI, program(app, event, -1).apply {
+                        put("channel_id", channelId); put("weight", 20 - i)
+                    })
+                }
+                Log.i("AstraPreviews", "Published ${events.size} app previews")
+            }.onFailure { Log.w("AstraPreviews", "Could not publish app previews", it) }
+        }
+    }
+
+    fun continueWatching(context: Context, event: Event, feed: Int) {
+        val app = context.applicationContext
+        worker.execute {
+            runCatching {
+                val cr = app.contentResolver
+                cr.delete(TvContract.WatchNextPrograms.CONTENT_URI, null, null)
+                cr.insert(TvContract.WatchNextPrograms.CONTENT_URI, program(app, event, feed).apply {
+                    put("watch_next_type", 0)
+                    put("last_engagement_time_utc_millis", System.currentTimeMillis())
+                })
+                Log.i("AstraPreviews", "Published continue watching")
+            }.onFailure { Log.w("AstraPreviews", "Could not publish continue watching", it) }
+        }
+    }
+
+    private fun program(context: Context, event: Event, feed: Int): ContentValues {
+        val hash = MessageDigest.getInstance("SHA-256").digest(event.id.toByteArray()).joinToString("") { "%02x".format(it) }
+        val dir = File(context.filesDir, "preview-art").apply { mkdirs() }
+        val title = event.name.ifBlank { listOfNotNull(event.home?.name, event.away?.name).joinToString(" vs ") }
+        File(dir, "$hash.json").writeText(JSONObject().put("title", title).put("competition", event.competitionName ?: event.sport)
+            .put("status", event.status).toString())
+        val link = Intent(context, MainActivity::class.java).putExtra("astra_event_id", event.id).putExtra("astra_feed_index", feed)
+        if(feed >= 0) event.feeds.getOrNull(feed)?.let { link.putExtra("astra_feed_stream_id", it.streamId) }
+        return ContentValues().apply {
+            put("type", 0); put("title", title); put("description", event.competitionName ?: event.sport)
+            put("internal_provider_id", event.id); put("searchable", 1)
+            put("poster_art_uri", "content://dev.astra.tv.previews/art/$hash"); put("poster_art_aspect_ratio", 0)
+            put("intent_uri", link.toUri(Intent.URI_INTENT_SCHEME))
+        }
+    }
+}
